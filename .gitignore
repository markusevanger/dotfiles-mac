# This repo is PUBLIC. Everything below is denied so that a careless
# `git add -A` after dropping a file into a package dir cannot leak it.
# The hooks/pre-commit scanner is the second line of defence.

# Machine-local overrides — this is where secrets belong (see CLAUDE.md).
# NOTE: do not use a bare `*.local` glob here; it would swallow
# tmux/.config/tmux/tmux.conf.local, which must be tracked.
.zshrc.local
zsh/.zshrc.local
.zshenv.local
.gitconfig.local
**/settings.local.json

# Credentials and keys
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keychain
id_rsa*
id_ed25519*
*_rsa
*_ed25519
.netrc
.npmrc
.pypirc
**/hosts.yml
**/credentials
**/*credentials*
**/*token*
**/.aws/
**/.ssh/
**/gh/

# Shell and editor state
.zsh_history
.zsh_sessions/
.*history
*.swp
*.swo
*~
*.bak
*.bak-*

# macOS
.DS_Store
