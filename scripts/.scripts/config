#!/bin/zsh

local configs=(
  "📝 zshrc:~/.zshrc"
  "📁 scripts:~/.scripts"
  "🖥️ tmux:~/.config/tmux/tmux.conf.local"
  "🤖 claude (root):~/.claude/settings.json"
)

local names=()
local paths=()
for item in "${configs[@]}"; do
  names+=("${item%%:*}")
  paths+=("${item#*:}")
done

local selected=0
local total=${#names[@]}

tput civis
trap 'tput cnorm; exit' INT TERM

while true; do
  clear
  echo ""
  echo "\033[1;35m  ╭───────────────────────────────╮\033[0m"
  echo "\033[1;35m  │\033[0m   \033[1;37m⚙️  Config Selector\033[0m        \033[1;35m│\033[0m"
  echo "\033[1;35m  ├───────────────────────────────┤\033[0m"

  for i in {1..$total}; do
    local idx=$((i-1))
    if [[ $idx -eq $selected ]]; then
      echo "\033[1;35m  │\033[0m  \033[1;33m▸ ${names[$i]}\033[0m$(printf '%*s' $((22-${#names[$i]})) '')\033[1;35m│\033[0m"
    else
      echo "\033[1;35m  │\033[0m    \033[0;37m${names[$i]}\033[0m$(printf '%*s' $((22-${#names[$i]})) '')\033[1;35m│\033[0m"
    fi
  done

  echo "\033[1;35m  ╰───────────────────────────────╯\033[0m"
  echo ""
  echo "\033[1;36m     ↑↓\033[0;37m navigate  \033[1;36m⏎\033[0;37m select  \033[1;36mq\033[0;37m quit\033[0m"
  
  read -rsk1 key
  case "$key" in
    $'\x1b')
      read -rsk2 -t 0.01 seq
      case "$seq" in
        '[A') ((selected > 0)) && ((selected--)) ;;
        '[B') ((selected < total-1)) && ((selected++)) ;;
      esac
      ;;
    $'\n')
      tput cnorm
      local config_path="${paths[$((selected+1))]}"
      eval nvim "$config_path"
      exit
      ;;
    q|Q)
      tput cnorm
      clear
      exit
      ;;
  esac
done
