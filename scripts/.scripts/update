#!/bin/zsh

local updates=(
  "pnpm:pnpm self-update"
  "Vercel CLI:pnpm i -g vercel@latest"
  "Sanity CLI:pnpm update -g @sanity/cli"
  "Homebrew:brew update && brew upgrade"
  "Oh My Zsh:omz update"
  "fnm:curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell"
  "Bun:bun upgrade"
  "macOS:softwareupdate -ia"
)

local names=()
local cmds=()
for item in "${updates[@]}"; do
  names+=("${item%%:*}")
  cmds+=("${item#*:}")
done

local total=${#names[@]}
local selected=0
local -A checked
for i in {1..$total}; do
  checked[$i]=1
done

local box_width=38

draw() {
  clear
  echo ""
  echo "\033[1;35m  ╭──────────────────────────────────────╮\033[0m"
  echo "\033[1;35m  │\033[0m   \033[1;37m🔄 Update All\033[0m                      \033[1;35m│\033[0m"
  echo "\033[1;35m  ├──────────────────────────────────────┤\033[0m"

  for i in {1..$total}; do
    local idx=$((i-1))
    local mark=" "
    [[ ${checked[$i]} -eq 1 ]] && mark="\033[1;32m✓\033[0m"

    local name="${names[$i]}"
    local pad=$((30 - ${#name}))

    if [[ $idx -eq $selected ]]; then
      echo "\033[1;35m  │\033[0m  \033[1;33m▸\033[0m [$mark] \033[1;33m${name}\033[0m$(printf '%*s' $pad '')\033[1;35m│\033[0m"
    else
      echo "\033[1;35m  │\033[0m    [$mark] \033[0;37m${name}\033[0m$(printf '%*s' $pad '')\033[1;35m│\033[0m"
    fi
  done

  echo "\033[1;35m  ╰──────────────────────────────────────╯\033[0m"
  echo ""
  echo "\033[1;36m   ↑↓\033[0;37m navigate  \033[1;36m⎵\033[0;37m toggle  \033[1;36m⏎\033[0;37m run  \033[1;36mq\033[0;37m quit\033[0m"
  echo "\033[1;36m    a\033[0;37m all       \033[1;36mn\033[0;37m none\033[0m"
}

tput civis
trap 'tput cnorm; exit' INT TERM

while true; do
  draw

  read -rsk1 key
  case "$key" in
    $'\x1b')
      read -rsk2 -t 0.01 seq
      case "$seq" in
        '[A') ((selected > 0)) && ((selected--)) ;;
        '[B') ((selected < total-1)) && ((selected++)) ;;
      esac
      ;;
    ' ')
      local i=$((selected+1))
      if [[ ${checked[$i]} -eq 1 ]]; then
        checked[$i]=0
      else
        checked[$i]=1
      fi
      ;;
    a|A)
      for i in {1..$total}; do checked[$i]=1; done
      ;;
    n|N)
      for i in {1..$total}; do checked[$i]=0; done
      ;;
    $'\n')
      tput cnorm
      clear

      local any=0
      for i in {1..$total}; do
        [[ ${checked[$i]} -eq 1 ]] && any=1 && break
      done

      if [[ $any -eq 0 ]]; then
        echo "\033[1;35m  ╭──────────────────────────────────────╮\033[0m"
        echo "\033[1;35m  │\033[0m   \033[0;37m💤 Nothing selected\033[0m                  \033[1;35m│\033[0m"
        echo "\033[1;35m  ╰──────────────────────────────────────╯\033[0m"
        exit
      fi

      local count=0
      local failures=0

      for i in {1..$total}; do
        [[ ${checked[$i]} -ne 1 ]] && continue
        ((count++))
      done

      local current=0
      for i in {1..$total}; do
        [[ ${checked[$i]} -ne 1 ]] && continue
        ((current++))

        echo ""
        echo "\033[1;35m  ╭──────────────────────────────────────╮\033[0m"
        echo "\033[1;35m  │\033[0m  \033[1;37m[$current/$count]\033[0m Updating \033[1;33m${names[$i]}\033[0m$(printf '%*s' $((20 - ${#names[$i]})) '')\033[1;35m│\033[0m"
        echo "\033[1;35m  ╰──────────────────────────────────────╯\033[0m"
        echo ""

        eval "${cmds[$i]}" 2>&1
        if [[ $? -ne 0 ]]; then
          echo ""
          echo "\033[1;31m  ✗ ${names[$i]} failed\033[0m"
          ((failures++))
        else
          echo ""
          echo "\033[1;32m  ✓ ${names[$i]} done\033[0m"
        fi
      done

      echo ""
      echo "\033[1;35m  ╭──────────────────────────────────────╮\033[0m"
      if [[ $failures -eq 0 ]]; then
        echo "\033[1;35m  │\033[0m   \033[1;32m✓ All $count update(s) complete\033[0m$(printf '%*s' $((13 - ${#count})) '')\033[1;35m│\033[0m"
      else
        echo "\033[1;35m  │\033[0m   \033[1;33m⚠ Done: $((count-failures)) ok, $failures failed\033[0m$(printf '%*s' $((14 - ${#count})) '')\033[1;35m│\033[0m"
      fi
      echo "\033[1;35m  ╰──────────────────────────────────────╯\033[0m"
      exit
      ;;
    q|Q)
      tput cnorm
      clear
      exit
      ;;
  esac
done
